# Cau hinh SHOP THAT. Sao chep thanh .env.live roi dien khoa Live.
# Chay bang: npm run start:live   va   npm run cli:live -- status
# Tuyet doi khong commit tep .env.live len git (da chan trong .gitignore).

# ---- Lay tu Console > App List, phan Live (co sau khi Go-Live duoc duyet) ----
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=

# ---- Moi truong that. Viet Nam thuoc vung GLOBAL ----
SHOPEE_REGION=GLOBAL

# ---- Dia chi nhan uy quyen, khop voi Live Redirect URL Domain trong Console ----
# Shopee that so khop TUYET DOI ca so cong: Console khai http://localtest.me
# thi dia chi o day KHONG duoc co :3000, nen may chu chay cong 80 (cong mac
# dinh cua web). Mo trang bang http://localtest.me
SHOPEE_REDIRECT_URI=http://localtest.me/auth/callback

PORT=80

# ---- Token shop that luu tep RIENG, khong dung chung voi thu nghiem ----
TOKEN_FILE=./data/shopee-token-live.json

TOKEN_KEEPALIVE_MINUTES=60
