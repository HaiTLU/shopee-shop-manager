# Sao chep tep nay thanh .env roi dien gia tri that.
# Tuyet doi khong commit tep .env len git.

# ---- Lay tu open.shopee.com > App Management > App List ----
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=

# ---- Moi truong ----
# TEST_GLOBAL = sandbox (dung de thu nghiem, khong dung cho shop that)
# GLOBAL      = that (Viet Nam dung vung nay)
SHOPEE_REGION=TEST_GLOBAL

# ---- Dia chi nhan uy quyen ----
# Phai khai y het chuoi nay trong Console cua Shopee, ke ca dau / o cuoi.
# Khi chay tren may ca nhan de thu: http://localhost:3000/auth/callback
SHOPEE_REDIRECT_URI=http://localhost:3000/auth/callback

# ---- May chu web ----
PORT=3000

# ---- Noi luu token ----
# Mac dinh la ./data/shopee-token.json
TOKEN_FILE=./data/shopee-token.json

# ---- Ghi de dia chi Shopee (thuong bo trong) ----
# Chi dien khi khoa thu nghiem bao loi voi dia chi mac dinh cua SDK.
# Dia chi sandbox cu: https://partner.test-stable.shopeemobile.com/api/v2
# SHOPEE_BASE_URL=
# SHOPEE_AUTH_URL=

# ---- Tu dong gia han token ----
# So phut giua hai lan kiem tra. Dat 0 de tat.
TOKEN_KEEPALIVE_MINUTES=60
