{
  "name": "shopee-shop-manager",
  "version": "0.1.0",
  "description": "Trang quan ly shop Shopee qua Open Platform API v2",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "start:live": "ENV_FILE=.env.live tsx src/server.ts",
    "cli": "tsx src/cli.ts",
    "cli:live": "ENV_FILE=.env.live tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@congminh1254/shopee-sdk": "^2.6.0",
    "dotenv": "^18.0.1",
    "exceljs": "^4.4.0",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
